# Ingestão com OpenAI. Chave real somente em .env, .env.local ou ambiente.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
